{
	"schemaVersion": 1,
	"id": "contentpacks",
	"version": "${version}",
	"name": "Content Packs",
	"description": "Stuff loaded via json at runtime.",
	"authors": [
		"Moineau"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/contentpacks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"mod.moineau.contentpacks.ContentPacks"
		],
		"client": [
			"mod.moineau.contentpacks.ContentPacksClient"
		]
	},
	"mixins": [
		"contentpacks.mixins.json",
		{
			"config": "contentpacks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.7",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"accessWidener" : "contentpacks.accesswidener"
}